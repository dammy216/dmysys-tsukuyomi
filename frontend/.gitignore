# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# large media excluded from git (exceeds GitHub 100MB limit)
/public/流れ星の正体ヤチヨ.mp4
# 配信用に圧縮した 星降る海.mp4 / reply.mp4 のみコミット。
# 編集元の原本(*_original)や書き出しイテレーション(replyv2 等)は管理外
/public/videos/*_original.*
/public/videos/replyv*.*

# typescript
*.tsbuildinfo
next-env.d.ts
