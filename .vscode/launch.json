{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm start",
      "name": "モバイル",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/mobile"
    },
    {
      "name": "モバイルデバッグ",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}/mobile"
    },
    {
      "command": ".venv/Scripts/uvicorn main:socket_app --host 0.0.0.0 --port 8080 --reload",
      "name": "サーバー",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "command": "python watch_rive.py",
      "name": "アニメーション",
      "request": "launch",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/rive/scripts"
    },
  ]
}
